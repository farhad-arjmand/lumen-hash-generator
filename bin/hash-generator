#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoload = $GLOBALS['_composer_autoload_path'] ?? __DIR__ . '/../vendor/autoload.php';
if (!is_file($autoload)) {
    fwrite(STDERR, "Install dependencies with Composer first.\n");
    exit(1);
}
require $autoload;
try {
    fwrite(STDOUT, (new FarhadArjmand\LumenHashGenerator\Console())->run(array_slice($argv, 1)));
} catch (InvalidArgumentException $exception) {
    fwrite(STDERR, $exception->getMessage() . "\n");
    exit(2);
} catch (Throwable) {
    fwrite(STDERR, "Token generation failed; no insecure fallback was used.\n");
    exit(1);
}
